{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Krateo PlatformOps Installer",
  "description": "Umbrella orchestrator. Create one Installer Composition per Krateo platform installation. It registers and emits the component blueprints (forked into the braghettos org) in dependency order. Pinned to installer 2.7.0.",
  "additionalProperties": false,
  "properties": {
    "ociRepo": {
      "type": "string",
      "title": "OCI chart repository",
      "default": "oci://ghcr.io/braghettos/charts"
    },
    "installDefinitions": {
      "type": "boolean",
      "title": "Register component CompositionDefinitions",
      "default": true
    },
    "global": {
      "type": "object",
      "title": "Global values",
      "description": "Helm global values (injected by the composition runtime / when used with subcharts)."
    },
    "bootstrap": {
      "type": "object",
      "title": "Bootstrap (composition engine)",
      "description": "Install core-provider as a hook-weighted subchart so a bare-cluster helm install self-bootstraps. Disable when registering on an existing Krateo.",
      "additionalProperties": false,
      "properties": {
        "coreProvider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "version": {
              "type": "string",
              "default": "0.35.2"
            }
          }
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "clickhouseOperator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "mongodbOperator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "kagent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "core-provider": {
      "type": "object",
      "title": "core-provider subchart values",
      "description": "Passthrough to the bootstrap core-provider subchart."
    },
    "core-provider-crd": {
      "type": "object",
      "title": "core-provider-crd subchart values",
      "description": "Passthrough to the bootstrap core-provider-crd subchart."
    },
    "cert-manager": {
      "type": "object",
      "title": "cert-manager subchart values",
      "description": "Passthrough to the bootstrap cert-manager subchart."
    },
    "clickhouse-operator-helm": {
      "type": "object",
      "title": "clickhouse-operator subchart values",
      "description": "Passthrough to the bootstrap ClickHouse operator subchart."
    },
    "community-operator": {
      "type": "object",
      "title": "mongodb community-operator subchart values",
      "description": "Passthrough to the bootstrap MongoDB community-operator subchart."
    },
    "kagent-crds": {
      "type": "object",
      "title": "kagent-crds subchart values",
      "description": "Passthrough to the bootstrap kagent-crds subchart."
    },
    "kagent": {
      "type": "object",
      "title": "kagent subchart values",
      "description": "Passthrough to the bootstrap kagent operator subchart."
    },
    "namespaces": {
      "type": "object",
      "title": "Namespaces",
      "additionalProperties": false,
      "properties": {
        "krateo": {
          "type": "string",
          "default": "krateo-system"
        },
        "clickhouse": {
          "type": "string",
          "default": "krateo-system"
        }
      }
    },
    "exposure": {
      "type": "object",
      "title": "Exposure",
      "description": "How browser-facing components are reached. NodePort/LoadBalancer are resolved via Helm lookup at reconcile time; Ingress uses the host inputs.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NodePort",
            "LoadBalancer",
            "Ingress"
          ],
          "default": "NodePort"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "domain": {
              "type": "string",
              "default": ""
            },
            "authnHost": {
              "type": "string",
              "default": ""
            },
            "snowplowHost": {
              "type": "string",
              "default": ""
            },
            "frontendHost": {
              "type": "string",
              "default": ""
            },
            "hyperdxHost": {
              "type": "string",
              "default": ""
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "title": "Feature flags",
      "additionalProperties": false,
      "properties": {
        "composableportal": {
          "type": "boolean",
          "default": true
        },
        "composableportalstarter": {
          "type": "boolean",
          "default": true
        },
        "composableoperations": {
          "type": "boolean",
          "default": true
        },
        "oasgenprovider": {
          "type": "boolean",
          "default": true
        },
        "observability": {
          "type": "boolean",
          "default": true
        },
        "observabilityAgents": {
          "type": "boolean",
          "default": true
        },
        "githubMcp": {
          "type": "boolean",
          "default": false
        },
        "podRestartAlert": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "secrets": {
      "type": "object",
      "title": "Secret references",
      "description": "Names of pre-existing Secrets. Values are never inlined in the blueprint.",
      "additionalProperties": false,
      "properties": {
        "geminiApiKey": {
          "type": "string",
          "default": "gemini-api-key"
        },
        "gcloudCredentials": {
          "type": "string",
          "default": "gcloud-credentials"
        },
        "githubMcpPat": {
          "type": "string",
          "default": "github-mcp-pat"
        }
      }
    },
    "components": {
      "type": "array",
      "title": "Component DAG (advanced override)",
      "description": "Advanced: override the built-in component list/versions/dependencies.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tier": {
            "type": "string",
            "enum": [
              "platform",
              "observability"
            ]
          },
          "feature": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "expose": {
            "type": "boolean"
          },
          "exposePort": {
            "type": "integer"
          },
          "svcMatch": {
            "type": "string"
          },
          "consumer": {
            "type": "boolean"
          },
          "configKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vertexAI": {
            "type": "boolean",
            "description": "Inject the umbrella's .vertexAI block into this component's Composition spec (krateo-autopilot)."
          }
        },
        "required": [
          "name",
          "kind",
          "version",
          "tier"
        ]
      }
    },
    "vertexAI": {
      "type": "object",
      "title": "Gemini Vertex AI",
      "description": "Vertex AI for the autopilot agents via Application Default Credentials (no API key). Requires the GKE node SA to have aiplatform access and the cloud-platform OAuth scope.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "projectID": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "default": "us-central1"
        }
      }
    },
    "hitlApproval": {
      "type": "boolean",
      "title": "HITL approval",
      "description": "Autopilot mutating-tool approval gate. true=pause for approval; false=autonomous remediation."
    },
    "componentValues": {
      "type": "object",
      "title": "Per-component spec overrides",
      "description": "Map of component name -> object deep-merged into that component's rendered Composition spec (Pass B). The installer-computed wiring (service/config/vertexAI/hitlApproval) stays authoritative and wins on any leaf conflict. Edit in place on the live Installer composition to durably customize a component's spec.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
